<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container page-space trip-page">
  <%- include('../partials/flash') %>
  <a class="back-link" href="/dashboard">← Semua perjalanan</a>

  <section class="trip-hero">
    <div>
      <div class="hero-labels"><span class="pill"><%= trip.trip_type === 'group' ? 'Trip grup' : 'Trip solo' %></span><span class="pill soft"><%= trip.currency %></span></div>
      <h1><%= trip.name %></h1>
      <p>⌖ <%= trip.destination %> &nbsp;·&nbsp; <%= dateLabel(trip.start_date) %> s.d. <%= dateLabel(trip.end_date) %></p>
    </div>
    <div class="hero-budget"><span>Pengeluaran</span><strong><%= money(summary.actual, trip.currency) %></strong><small>dari budget <%= money(summary.overallBudget, trip.currency) %></small></div>
  </section>

  <nav class="section-tabs" aria-label="Trip sections">
    <a href="#overview">Ringkasan</a><a href="#itinerary">Itinerary</a><a href="#bookings">Booking</a><a href="#expenses">Pengeluaran</a><a href="#budget">Budget</a><a href="#people">Peserta</a>
  </nav>

  <section id="overview" class="trip-section">
    <div class="section-head"><div><h2>Ringkasan perjalanan</h2></div></div>
    <div class="summary-grid">
      <article class="summary-card"><span>Budget trip</span><strong><%= money(summary.overallBudget, trip.currency) %></strong><small>Target keseluruhan</small></article>
      <article class="summary-card"><span>Biaya terencana</span><strong><%= money(summary.planned, trip.currency) %></strong><small>Agenda + booking</small></article>
      <article class="summary-card"><span>Pengeluaran</span><strong><%= money(summary.actual, trip.currency) %></strong><small>Dari pengeluaran tercatat</small></article>
      <article class="summary-card <%= summary.remaining < 0 ? 'danger-card' : '' %>"><span>Sisa</span><strong><%= money(summary.remaining, trip.currency) %></strong><small><%= summary.remaining < 0 ? 'Melebihi budget' : 'Sisa budget' %></small></article>
    </div>

    <div class="grid-2 overview-grid">
      <article class="panel info-panel"><div class="panel-title"><h3>Informasi trip</h3><span class="text-badge"><%= members.length %> peserta</span></div>
        <dl class="info-list"><div><dt>Tujuan</dt><dd><%= trip.destination %></dd></div><div><dt>Tanggal</dt><dd><%= dateLabel(trip.start_date) %> s.d. <%= dateLabel(trip.end_date) %></dd></div><div><dt>Tipe</dt><dd><%= trip.trip_type === 'group' ? 'Trip grup' : 'Trip solo' %></dd></div><div><dt>Mata uang</dt><dd><%= trip.currency %></dd></div></dl>
        <% if (trip.notes) { %><div class="note-box"><small>Catatan trip</small><p><%= trip.notes %></p></div><% } %>
      </article>
      <article class="panel info-panel"><div class="panel-title"><h3>Status singkat</h3></div>
        <div class="quick-list"><div><span class="quick-icon">◷</span><p><b><%= itinerary.length %> agenda</b><small>Agenda terencana</small></p></div><div><span class="quick-icon">⌂</span><p><b><%= accommodations.length %> akomodasi</b><small>Hotel / tempat menginap</small></p></div><div><span class="quick-icon">↝</span><p><b><%= transportation.length %> transport</b><small>Flight / train / car</small></p></div><div><span class="quick-icon">$</span><p><b><%= expenses.length %> pengeluaran</b><small>Transaksi tercatat</small></p></div></div>
      </article>
    </div>

    <% if (Number(trip.owner_id) === Number(currentUser.id)) { %>
    <details class="panel add-panel"><summary>Edit informasi trip <span>＋</span></summary>
      <form action="/trips/<%= trip.id %>/update" method="post" class="form-grid two form-inside">
        <label>Nama trip<input name="name" value="<%= trip.name %>" required></label><label>Tujuan<input name="destination" value="<%= trip.destination %>" required></label>
        <label>Mulai<input type="date" name="start_date" value="<%= inputDate(trip.start_date) %>" required></label><label>Selesai<input type="date" name="end_date" value="<%= inputDate(trip.end_date) %>" required></label>
        <label>Mata uang<input name="currency" maxlength="3" value="<%= trip.currency %>" required></label><label>Budget trip<input type="number" step="0.01" min="0" name="overall_budget" value="<%= Number(trip.overall_budget) %>"></label>
        <label class="span-2">Catatan<textarea name="notes" rows="3"><%= trip.notes || '' %></textarea></label><div class="span-2 form-actions"><button class="btn btn-primary" type="submit">Simpan perubahan</button></div>
      </form>
    </details>
    <% } %>
  </section>

  <section id="itinerary" class="trip-section">
    <div class="section-head"><div><h2>Agenda perjalanan</h2><p class="muted">Susun aktivitas per hari dan estimasi biayanya.</p></div></div>
    <details class="panel add-panel" open><summary>+ Tambah agenda <span>Atur waktu, lokasi & biaya</span></summary>
      <form action="/trips/<%= trip.id %>/itinerary" method="post" class="form-grid four form-inside">
        <label>Tanggal<input type="date" name="item_date" min="<%= inputDate(trip.start_date) %>" max="<%= inputDate(trip.end_date) %>" value="<%= inputDate(trip.start_date) %>" required></label>
        <label>Mulai<input type="time" name="start_time"></label><label>Selesai<input type="time" name="end_time"></label>
        <label>Kategori<select name="category"><option value="activity">Aktivitas</option><option value="food">Makan</option><option value="sightseeing">Wisata</option><option value="shopping">Belanja</option><option value="meeting">Pertemuan</option><option value="free-time">Waktu bebas</option></select></label>
        <label class="span-2">Judul agenda<input name="title" required placeholder="Visit Senso-ji Temple"></label><label class="span-2">Lokasi<input name="location" placeholder="Asakusa, Tokyo"></label>
        <label>Estimasi biaya<input type="number" step="0.01" min="0" name="estimated_cost" placeholder="0"></label><label class="span-3">Catatan<input name="notes" placeholder="Reservation, ticket, meeting point..."></label>
        <div class="span-4 form-actions"><button class="btn btn-primary" type="submit">Tambah agenda</button></div>
      </form>
    </details>

    <% if (!itinerary.length) { %><div class="inline-empty">Belum ada agenda. Tambahkan aktivitas pertama di atas.</div><% } %>
    <% Object.entries(groupedItinerary).forEach(([day, items]) => { %>
      <div class="day-block"><div class="day-heading"><div><span><%= shortDate(day) %></span><small><%= items.length %> agenda</small></div><strong><%= money(items.reduce((a,x)=>a+Number(x.estimated_cost||0),0), trip.currency) %></strong></div>
        <div class="timeline">
          <% items.forEach(item => { %><article class="timeline-item"><div class="time"><%= item.start_time ? String(item.start_time).slice(0,5) : 'Fleksibel' %></div><div class="timeline-dot"></div><div class="timeline-content"><div class="timeline-top"><div><span class="category-tag"><%= item.category %></span><h3><%= item.title %></h3></div><form action="/trips/<%= trip.id %>/itinerary/<%= item.id %>/delete" method="post" data-confirm="Hapus agenda ini?"><button class="delete-btn" type="submit">×</button></form></div><p><%= item.location ? `⌖ ${item.location}` : 'Lokasi belum diisi' %></p><% if(item.notes){%><small><%= item.notes %></small><%}%><div class="cost-line"><span>Estimasi</span><b><%= money(item.estimated_cost, trip.currency) %></b></div></div></article><% }) %>
        </div>
      </div>
    <% }) %>
  </section>

  <section id="bookings" class="trip-section">
    <div class="section-head"><div><h2>Akomodasi & transportasi</h2><p class="muted">Simpan detail booking dan estimasi biaya perjalanan.</p></div></div>
    <div class="grid-2 booking-grid">
      <div>
        <details class="panel add-panel"><summary>+ Tambah akomodasi <span>Hotel / villa / apartment</span></summary><form action="/trips/<%= trip.id %>/accommodations" method="post" class="form-grid two form-inside">
          <label class="span-2">Nama akomodasi<input name="name" required placeholder="Hotel Gracery Shinjuku"></label><label class="span-2">Lokasi<input name="location" placeholder="Shinjuku, Tokyo"></label><label>Check-in<input type="date" name="check_in" required></label><label>Check-out<input type="date" name="check_out" required></label><label>Booking ref<input name="booking_ref" placeholder="ABC123"></label><label>Total biaya<input type="number" step="0.01" min="0" name="total_cost" placeholder="0"></label><label class="span-2">Catatan<input name="notes" placeholder="Breakfast included, room type..."></label><div class="span-2 form-actions"><button class="btn btn-primary" type="submit">Simpan akomodasi</button></div>
        </form></details>
        <div class="stack-list"><% accommodations.forEach(a => { %><article class="booking-card"><div class="booking-icon">⌂</div><div class="booking-main"><div class="booking-top"><div><h3><%= a.name %></h3><p><%= a.location || 'Lokasi belum diisi' %></p></div><form action="/trips/<%= trip.id %>/accommodations/<%= a.id %>/delete" method="post" data-confirm="Hapus akomodasi ini?"><button class="delete-btn" type="submit">×</button></form></div><div class="booking-meta"><span><%= dateLabel(a.check_in) %> → <%= dateLabel(a.check_out) %></span><span><%= a.booking_ref ? `Ref: ${a.booking_ref}` : 'Belum ada booking ref' %></span></div><strong><%= money(a.total_cost, trip.currency) %></strong></div></article><% }) %><% if(!accommodations.length){%><div class="inline-empty">Belum ada akomodasi.</div><%}%></div>
      </div>
      <div>
        <details class="panel add-panel"><summary>+ Tambah transport <span>Flight / train / car</span></summary><form action="/trips/<%= trip.id %>/transport" method="post" class="form-grid two form-inside">
          <label>Mode<select name="mode"><option>Flight</option><option>Train</option><option>Bus</option><option>Car</option><option>Ferry</option><option>Taxi</option><option>Other</option></select></label><label>Provider<input name="provider" placeholder="Garuda Indonesia"></label><label>Asal<input name="origin" required placeholder="CGK"></label><label>Tujuan<input name="destination" required placeholder="HND"></label><label>Berangkat<input type="datetime-local" name="departure_at"></label><label>Tiba<input type="datetime-local" name="arrival_at"></label><label>Booking ref<input name="booking_ref" placeholder="PNR / ticket no"></label><label>Total biaya<input type="number" step="0.01" min="0" name="total_cost" placeholder="0"></label><label class="span-2">Catatan<input name="notes" placeholder="Baggage, seat, terminal..."></label><div class="span-2 form-actions"><button class="btn btn-primary" type="submit">Simpan transport</button></div>
        </form></details>
        <div class="stack-list"><% transportation.forEach(t => { %><article class="booking-card"><div class="booking-icon">↝</div><div class="booking-main"><div class="booking-top"><div><h3><%= t.mode %><%= t.provider ? ` · ${t.provider}` : '' %></h3><p><%= t.origin %> → <%= t.destination %></p></div><form action="/trips/<%= trip.id %>/transport/<%= t.id %>/delete" method="post" data-confirm="Hapus transport ini?"><button class="delete-btn" type="submit">×</button></form></div><div class="booking-meta"><span><%= t.departure_at ? new Date(t.departure_at).toLocaleString('id-ID',{dateStyle:'medium',timeStyle:'short'}) : 'Jadwal belum diisi' %></span><span><%= t.booking_ref ? `Ref: ${t.booking_ref}` : 'Belum ada booking ref' %></span></div><strong><%= money(t.total_cost, trip.currency) %></strong></div></article><% }) %><% if(!transportation.length){%><div class="inline-empty">Belum ada transport.</div><%}%></div>
      </div>
    </div>
  </section>

  <section id="expenses" class="trip-section">
    <div class="section-head"><div><h2>Pengeluaran & split bill</h2><p class="muted">Catat siapa yang membayar dan siapa saja yang ikut menanggung biaya.</p></div></div>
    <details class="panel add-panel" open><summary>+ Catat pengeluaran <span>Dibagi rata ke peserta terpilih</span></summary>
      <form action="/trips/<%= trip.id %>/expenses" method="post" class="form-grid four form-inside">
        <label>Tanggal<input type="date" name="expense_date" value="<%= inputDate(trip.start_date) %>" required></label><label class="span-2">Deskripsi<input name="description" required placeholder="Makan malam di Shibuya"></label><label>Kategori<select name="category"><option>food</option><option>transport</option><option>accommodation</option><option>activity</option><option>shopping</option><option>other</option></select></label>
        <label>Nominal<input type="number" step="0.01" min="0.01" name="amount" required placeholder="0"></label><label>Dibayar oleh<select name="paid_by_member_id" required><% members.forEach(m=>{%><option value="<%= m.id %>"><%= m.display_name %></option><%})%></select></label><label class="span-2">Catatan<input name="notes" placeholder="Catatan opsional"></label>
        <fieldset class="span-4 split-field"><legend>Split untuk</legend><div class="member-checks"><% members.forEach(m=>{%><label><input type="checkbox" name="participants" value="<%= m.id %>" checked><span><%= m.display_name %></span></label><%})%></div><small>Jika semua dicentang, biaya dibagi rata ke seluruh peserta.</small></fieldset>
        <div class="span-4 form-actions"><button class="btn btn-primary" type="submit">Simpan pengeluaran</button></div>
      </form>
    </details>

    <div class="table-wrap panel"><table><thead><tr><th>Tanggal</th><th>Pengeluaran</th><th>Dibayar oleh</th><th>Kategori</th><th class="right">Nominal</th><th></th></tr></thead><tbody>
      <% expenses.forEach(e=>{%><tr><td><%= shortDate(e.expense_date) %></td><td><strong><%= e.description %></strong><% if(e.notes){%><small class="table-sub"><%= e.notes %></small><%}%></td><td><%= e.paid_by_name %></td><td><span class="category-tag"><%= e.category %></span></td><td class="right"><strong><%= money(e.amount,trip.currency) %></strong></td><td><form action="/trips/<%= trip.id %>/expenses/<%= e.id %>/delete" method="post" data-confirm="Hapus expense ini?"><button class="delete-btn" type="submit">×</button></form></td></tr><%})%>
      <% if(!expenses.length){%><tr><td colspan="6" class="table-empty">Belum ada pengeluaran tercatat.</td></tr><%}%>
    </tbody></table></div>

    <% if (trip.trip_type === 'group' && expenses.length) { %>
    <div class="grid-2 settle-grid"><article class="panel"><div class="panel-title"><h3>Saldo per peserta</h3><span class="text-badge">Aktual</span></div><div class="balance-list"><% balances.forEach(b=>{%><div><span><b><%= b.display_name %></b><small>Bayar <%= money(b.paid,trip.currency) %> · Bagian <%= money(b.owed,trip.currency) %></small></span><strong class="<%= b.balance >= 0 ? 'positive' : 'negative' %>"><%= b.balance>=0?'+':'' %><%= money(b.balance,trip.currency) %></strong></div><%})%></div></article>
      <article class="panel"><div class="panel-title"><h3>Siapa membayar siapa</h3><span class="text-badge">Transfer minimum</span></div><div class="settlement-list"><% transfers.forEach(x=>{%><div><span><b><%= x.from %></b> bayar <b><%= x.to %></b></span><strong><%= money(x.amount,trip.currency) %></strong></div><%})%><% if(!transfers.length){%><div class="inline-empty">Semua saldo sudah seimbang.</div><%}%></div></article></div>
    <% } %>
  </section>

  <section id="budget" class="trip-section">
    <div class="section-head"><div><h2>Budget per orang</h2><p class="muted">Bandingkan batas budget tiap peserta dengan bagian pengeluaran aktual.</p></div></div>
    <div class="budget-progress panel"><div><span><b>Pemakaian budget trip</b><small><%= money(summary.actual,trip.currency) %> dari <%= money(summary.overallBudget,trip.currency) %></small></span><strong><%= summary.overallBudget > 0 ? Math.round((summary.actual/summary.overallBudget)*100) : 0 %>%</strong></div><div class="progress"><span style="width:<%= summary.overallBudget>0 ? Math.min(100,(summary.actual/summary.overallBudget)*100) : 0 %>%"></span></div></div>
    <div class="member-budget-grid"><% balances.forEach(b=>{%><article class="panel member-budget"><div class="member-head"><span class="avatar"><%= b.display_name.slice(0,1).toUpperCase() %></span><div><h3><%= b.display_name %></h3><small><%= b.role %></small></div></div><div class="budget-numbers"><div><span>Batas budget</span><strong><%= money(b.budget_limit,trip.currency) %></strong></div><div><span>Bagian aktual</span><strong><%= money(b.owed,trip.currency) %></strong></div><div><span>Sisa</span><strong class="<%= Number(b.budget_limit)-b.owed < 0 ? 'negative' : 'positive' %>"><%= money(Number(b.budget_limit)-b.owed,trip.currency) %></strong></div></div>
      <% if(Number(trip.owner_id)===Number(currentUser.id)){%><form action="/trips/<%= trip.id %>/members/<%= b.id %>/budget" method="post" class="inline-budget"><input type="number" step="0.01" min="0" name="budget_limit" value="<%= Number(b.budget_limit) %>"><button class="btn btn-secondary btn-sm" type="submit">Simpan budget</button></form><%}%></article><%})%></div>
  </section>

  <section id="people" class="trip-section">
    <div class="section-head"><div><h2>Peserta perjalanan</h2><p class="muted">Kelola anggota trip dan bagikan link undangan.</p></div></div>
    <% if (trip.trip_type === 'group' && inviteUrl && Number(trip.owner_id)===Number(currentUser.id)) { %><article class="invite-panel panel"><div><div><h3>Link undangan</h3><p>Bagikan link ini agar peserta dapat masuk dengan akun mereka sendiri.</p></div></div><div class="invite-row"><input id="inviteUrl" value="<%= inviteUrl %>" readonly><button class="btn btn-primary" type="button" data-copy="#inviteUrl">Salin link</button><form action="/trips/<%= trip.id %>/invite/regenerate" method="post" data-confirm="Link lama akan tidak berlaku. Buat link baru?"><button class="btn btn-secondary" type="submit">Buat ulang</button></form></div></article><% } %>

    <% if (trip.trip_type === 'group' && Number(trip.owner_id)===Number(currentUser.id)) { %><details class="panel add-panel"><summary>+ Tambah peserta manual <span>Untuk anggota yang belum punya akun</span></summary><form action="/trips/<%= trip.id %>/members" method="post" class="form-grid three form-inside"><label>Nama<input name="display_name" required placeholder="Nama peserta"></label><label>Email<input type="email" name="email" placeholder="Opsional"></label><label>Batas budget<input type="number" step="0.01" min="0" name="budget_limit" placeholder="0"></label><div class="span-3 form-actions"><button class="btn btn-primary" type="submit">Tambah peserta</button></div></form></details><% } %>

    <div class="people-grid"><% members.forEach(m=>{%><article class="person-card panel"><span class="avatar lg"><%= m.display_name.slice(0,1).toUpperCase() %></span><div class="person-main"><div><h3><%= m.display_name %></h3><p><%= m.email || 'Peserta manual' %></p></div><span class="role-badge"><%= m.role %></span></div><div class="person-bottom"><small><%= m.user_id ? 'Akun terhubung' : 'Belum terhubung' %></small><% if(Number(trip.owner_id)===Number(currentUser.id) && m.role!=='owner'){%><form action="/trips/<%= trip.id %>/members/<%= m.id %>/delete" method="post" data-confirm="Hapus peserta ini?"><button class="text-danger" type="submit">Hapus</button></form><%}%></div></article><%})%></div>

    <% if(Number(trip.owner_id)===Number(currentUser.id)){%><details class="danger-zone"><summary>Hapus trip</summary><div><p>Menghapus trip juga menghapus itinerary, booking, dan pengeluaran di dalamnya.</p><form action="/trips/<%= trip.id %>/delete" method="post" data-confirm="Hapus trip beserta seluruh datanya? Tindakan ini tidak dapat dibatalkan."><button class="btn btn-danger" type="submit">Hapus trip</button></form></div></details><%}%>
  </section>
</main>
<%- include('../partials/footer') %>
