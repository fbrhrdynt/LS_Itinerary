<%- include('../partials/head') %>
<main class="auth-page-centered">
  <section class="auth-card-centered" aria-labelledby="link-title">
    <h1 id="link-title">Hubungkan akun lama</h1>
    <p>Trip sudah tersimpan untuk <strong><%= email %></strong>. Verifikasi password Itinerary lama sekali untuk menghubungkannya dengan Febro Account.</p>
    <%- include('../partials/flash') %>
    <form action="/auth/link" method="post" class="form-stack">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <label>Password Itinerary lama<input type="password" name="password" autocomplete="current-password" required maxlength="1024"></label>
      <button class="btn btn-primary btn-block" type="submit">Hubungkan akun</button>
    </form>
    <p class="auth-switch"><a href="/forgot-password">Lupa Password?</a></p>
    <a href="/login">Kembali ke login</a>
  </section>
</main>
<%- include('../partials/footer') %>
