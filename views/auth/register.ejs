<%- include('../partials/head') %>
<main class="auth-shell">
  <section class="auth-visual">
    <div class="auth-brand wordmark-auth"><span class="wordmark-title">Itinerary</span><small>by Febro Herdyanto</small></div>
    <div class="auth-copy"><p class="context-label inverse">Mulai sekarang</p><h1>Bikin trip baru, lalu rapikan semua detailnya.</h1><p>Tujuan, peserta, booking, dan biaya tetap enak dilihat saat rencana berubah.</p></div>
    <div class="auth-points" aria-label="Alur penggunaan"><div><strong>Buat</strong><span>Pilih tujuan dan tanggal.</span></div><div><strong>Atur</strong><span>Tambahkan itinerary dan booking.</span></div><div><strong>Bagikan</strong><span>Undang teman dan split biaya.</span></div></div>
  </section>
  <section class="auth-panel">
    <div class="auth-card">
      <h2>Buat akun</h2><p class="muted">Pakai akun ini untuk menyimpan dan membagikan trip.</p>
      <%- include('../partials/flash') %>
      <form action="/register" method="post" class="form-stack">
        <label>Nama lengkap<input type="text" name="name" autocomplete="name" required minlength="2" placeholder="Nama Anda"></label>
        <label>Email<input type="email" name="email" autocomplete="email" required placeholder="nama@email.com"></label>
        <label>Password<input type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="Minimal 8 karakter"></label>
        <button class="btn btn-primary btn-block" type="submit">Buat akun</button>
      </form>
      <p class="auth-switch">Sudah punya akun? <a href="/login">Masuk</a></p>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
