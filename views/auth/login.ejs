<%- include('../partials/head') %>
<main class="auth-page-centered">
  <div class="auth-centered-shell">
    <header class="auth-centered-brand">
      <a class="brand wordmark" href="/login" aria-label="Itinerary by Febro Herdyanto">
        <span class="wordmark-title">Itinerary</span>
        <small>by Febro Herdyanto</small>
      </a>
    </header>

    <section class="auth-centered-hero">
      <p class="auth-kicker">Rencana perjalanan</p>
      <h1>Trip rapi.<br><span>Biaya jelas.</span></h1>
      <p class="auth-lead">Itinerary, peserta, booking, dan budget dalam satu workspace.</p>
      <div class="auth-feature-row" aria-label="Fitur utama"><span>Solo & grup</span><span>Itinerary</span><span>Split bill</span></div>
    </section>

    <section class="auth-card-centered" aria-labelledby="login-title">
      <div class="auth-card-head"><h2 id="login-title">Masuk</h2><p class="muted">Lanjutkan trip yang sedang Anda atur.</p></div>
      <%- include('../partials/flash') %>
      <form method="post" action="/login" class="form-stack"><input type="hidden" name="csrf" value="<%= loginCSRF %>"><label>Email<input name="email" type="email" required autocomplete="username"></label><label>Password<input name="password" type="password" required maxlength="128" autocomplete="current-password"></label><button type="submit" class="btn btn-primary">Masuk dengan password</button></form>
      <p class="auth-switch"><a href="/register">Daftar Akun</a> · <a href="/forgot-password">Lupa Password?</a> · <a href="/resend-activation">Kirim ulang aktivasi</a></p>
      <% if (ssoEnabled) { %>
        <div class="form-stack">
          <a class="btn btn-primary btn-block" href="/auth/febro">Masuk dengan Febro Account</a>
          <a class="btn btn-secondary btn-block" href="/auth/google">Masuk dengan Google</a>
        </div>
        <p class="auth-switch">Kedua pilihan menggunakan Febro Account. Akun baru dibuat saat pertama masuk.</p>

      <% } %>
    </section>
  </div>
</main>
<%- include('../partials/footer') %>
