<%- include('partials/head') %>
<% if (currentUser) { %><%- include('partials/nav') %><% } %>
<main class="container narrow page-space">
  <section class="error-state">
    <div class="error-number"><%= status %></div>
    <div class="error-copy">
      <p class="context-label"><%= status === 403 ? 'Akses' : status === 404 ? 'Halaman' : 'Server' %></p>
      <h1><%= title %></h1>
      <p><%= message %></p>
      <a class="btn btn-primary" href="<%= currentUser ? (isAdmin ? '/admin' : '/dashboard') : '/login' %>">Kembali</a>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
