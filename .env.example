NODE_ENV=production
HOST=127.0.0.1
PORT=3015
APP_NAME=LogiSource Itinerary
APP_URL=https://itinerary.febro.id
APP_TIMEZONE=Asia/Jakarta
SESSION_SECRET=change-this-to-a-long-random-secret
DATABASE_URL=postgresql://logisource_itinerary:change-this-password@127.0.0.1:5432/logisource_itinerary
DATABASE_SSL=false
OIDC_CLIENT_ID=febro-itinerary
OIDC_CLIENT_SECRET=

# Only needed when using docker-compose.yml
POSTGRES_DB=logisource_itinerary
POSTGRES_USER=logisource
POSTGRES_PASSWORD=change-this-password

# Password recovery requires SMTP_HOST (or SMTP_URL) and SMTP_FROM.
# SMTP on port 587 requires STARTTLS. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
